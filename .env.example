# Optional development/runtime overrides.
# Release packages should start without this file.
#
# Parqet OAuth client ID for local development/private integration.
# A future public release client ID will be supplied by the release build.
PARQET_CLIENT_ID=DEINE_CLIENT_ID

# Defaults shown below may be omitted.
BASE_URL=http://localhost:1337
PORT=1337
CURRENCY=EUR

# Optional test/portable user-data override:
# APP_DATA_DIR=/tmp/parqet-slm-test
